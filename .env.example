# ==========================================
# E-Commerce Data Lake Environment Variables
# ==========================================
# NOTE: DO NOT commit real secrets or credentials to version control.
# Copy this file to .env for local overrides if needed.

# Execution mode: 'local' (default) or 'aws'
PIPELINE_ENV=local

# AWS Configuration (Used only when PIPELINE_ENV=aws)
AWS_REGION=us-east-1
AWS_S3_BUCKET=my-ecommerce-data-lake-bucket
AWS_S3_PREFIX=ecommerce
AWS_GLUE_DATABASE=ecommerce_data_lake
AWS_ATHENA_OUTPUT_LOCATION=s3://my-ecommerce-data-lake-bucket/athena-results/

# Local Paths (defaults to ./data directories)
LOCAL_DATA_DIR=./data
LOCAL_STATE_DIR=./data/state

# Spark Configuration
SPARK_APP_NAME=EcommerceDataLakePipeline
SPARK_MASTER=local[*]
SPARK_DRIVER_MEMORY=2g

# Pipeline execution settings
LOG_LEVEL=INFO
SEED=42
